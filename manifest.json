{
  "manifest_version": 3,
  "name": "VPS Dashboard — Multi-Provider VPS Manager",
  "description": "Manage VPS servers across SolusVM, VirtFusion, and AWS EC2 — status, resources, batch operations, power actions, expiry reminders.",
  "version": "1.6.0",
  "default_locale": "en",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://*.amazonaws.com/*", "https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
