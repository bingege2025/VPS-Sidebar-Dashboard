{
  "manifest_version": 3,
  "name": "VPS Dashboard — Multi-Provider VPS Manager",
  "description": "__MSG_appDescription__",
  "version": "1.6.3",
  "default_locale": "en",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://*.amazonaws.com/*", "https://www.google-analytics.com/*", "https://region1.google-analytics.com/*", "https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
