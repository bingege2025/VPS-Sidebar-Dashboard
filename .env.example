# GA4 Measurement Protocol 凭据模板（构建期注入，不进仓库）
# 用法：
#   1. cp .env.example .env
#   2. 把下面三个值换成真实值（GA 后台 Admin 获取）
#   3. source .env && bash package-extension.sh
# 注意：.env 已被 .gitignore 忽略，切勿提交真实值。

# 测量 ID（G-XXXXXXX，非机密，可公开）
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# API Secret（MP 密钥，打包后会出现在扩展内，但绝不进 git 历史）
GA_API_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"

# 卸载反馈页域名（可选；不设置时打包脚本默认使用该地址）
UNINSTALL_URL="https://a.meng.mom"
